# CalcAI Backend Environment Configuration
# Copy this file to .env and configure your variables. Never commit .env to version control.

# Google Gemini API Key (Get yours from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# CORS Configuration (comma-separated origins or * for development)
ALLOWED_ORIGINS=*
